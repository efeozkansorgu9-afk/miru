# Backend environment. Copy to .env for local work; set these as environment
# variables in the platform's dashboard for a deployment. .env is gitignored
# and .env.example is not, so keep real values out of this file.

# TCMB EVDS key, for the inflation-adjusted returns.
# Free, from https://evds2.tcmb.gov.tr/ -> Giris Yap -> Profil -> API Anahtari.
# Optional: without it the API still answers, and the page simply omits the
# real-return section rather than failing.
EVDS_API_KEY=

# Origins the deployed frontend is served from, comma separated. localhost:3000
# and 127.0.0.1:3000 are always allowed and do not belong here. No trailing
# slash: a browser's Origin header has no path, and CORS compares strings.
# MIRU_ALLOWED_ORIGINS=https://your-app.vercel.app,https://miru.example.com

# Log level for the service. INFO is the default and is what you want in a
# deployment: the platform's log is the only window into the process.
# LOG_LEVEL=INFO

# Local-network CORS, for opening the dev frontend on a phone. Never set this
# in a deployment -- see DEV_ENV_VAR in api/main.py.
# MIRU_DEV=1

# Postgres for the nightly correlation job (jobs/nightly.py). No default and
# no fallback: the job refuses to start rather than guess at a database.
# The API does not read this -- nothing in api/ touches Postgres.
# DATABASE_URL=postgresql://user@localhost:5432/miru

# Where the correlation buckets draw their lines. All five are optional and
# all five have defaults in src/precompute.py; set one only to move it
# without a deploy. A value that will not parse stops the job rather than
# being silently ignored.
#   OVERLAPPING_MIN   interval's LOWER bound must clear this   (default 0.85)
#   SIMILAR_MIN       interval's LOWER bound must clear this   (default 0.60)
#   UNRELATED_MAX     interval's UPPER bound must be under it  (default 0.30)
#   MIN_WEEKS         fewer shared weeks than this, no verdict (default 52)
#   MAX_STALE_RATIO   share of zero-return weeks disqualifying (default 0.30)
# MIRU_CORR_OVERLAPPING_MIN=0.85
# MIRU_CORR_SIMILAR_MIN=0.60
# MIRU_CORR_UNRELATED_MAX=0.30
# MIRU_CORR_MIN_WEEKS=52
# MIRU_CORR_MAX_STALE_RATIO=0.30
