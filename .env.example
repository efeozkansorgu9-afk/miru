# Backend environment. Copy to .env for local work; set these as environment
# variables in the platform's dashboard for a deployment. .env is gitignored
# and .env.example is not, so keep real values out of this file.

# TCMB EVDS key, for the inflation-adjusted returns.
# Free, from https://evds2.tcmb.gov.tr/ -> Giris Yap -> Profil -> API Anahtari.
# Optional: without it the API still answers, and the page simply omits the
# real-return section rather than failing.
EVDS_API_KEY=

# Origins the deployed frontend is served from, comma separated. localhost:3000
# and 127.0.0.1:3000 are always allowed and do not belong here. No trailing
# slash: a browser's Origin header has no path, and CORS compares strings.
# MIRU_ALLOWED_ORIGINS=https://your-app.vercel.app,https://miru.example.com

# Log level for the service. INFO is the default and is what you want in a
# deployment: the platform's log is the only window into the process.
# LOG_LEVEL=INFO

# Local-network CORS, for opening the dev frontend on a phone. Never set this
# in a deployment -- see DEV_ENV_VAR in api/main.py.
# MIRU_DEV=1
